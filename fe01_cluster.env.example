export FE01_SPLIT_MANIFEST=__FILL__
export FE01_WEIGHTS_ROOT=__FILL__
export FE01_SPATIAL_MANIFEST=__FILL__
# Dedicated venv using the cluster's WORKING PyTorch/ROCm; never upgrade torch.
export FE01_PYTHON=__FILL__
