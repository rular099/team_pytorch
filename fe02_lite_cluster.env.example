# Optional: source the already working FE02 environment before this file, then
# map its paths/resources below. Do not upgrade/reinstall the cluster environment.
export FE02_LITE_OUTPUT_ROOT="${FE02_LITE_OUTPUT_ROOT:-$PWD/fe02_lite_runs}"
export FE02_LITE_DATA_ROOT="${FE02_LITE_DATA_ROOT:-${FE02_DATA_ROOT:-}}"
export FE02_LITE_SPLIT_MANIFEST="${FE02_LITE_SPLIT_MANIFEST:-${FE02_SPLIT_MANIFEST:-}}"
export FE02_LITE_SHARD_IDENTITY_MANIFEST="${FE02_LITE_SHARD_IDENTITY_MANIFEST:-}"
export FE02_LITE_DITING_CHECKPOINT="${FE02_LITE_DITING_CHECKPOINT:-${FE02_DITING_CHECKPOINT:-}}"
# Needed only when submitting from git rather than an already vendored code bundle.
export FE02_LITE_DTBENCH_ROOT="${FE02_LITE_DTBENCH_ROOT:-}"
export FE02_LITE_MODULE_LOADS="${FE02_LITE_MODULE_LOADS:-${FE02_MODULE_LOADS:-none}}"
export FE02_LITE_CONDA_SH="${FE02_LITE_CONDA_SH:-${FE02_CONDA_SH:-}}"
export FE02_LITE_CONDA_ENV="${FE02_LITE_CONDA_ENV:-${FE02_CONDA_ENV:-zb}}"
export FE02_LITE_LOGIN_PYTHON="${FE02_LITE_LOGIN_PYTHON:-python3}"
export FE02_LITE_PARTITION="${FE02_LITE_PARTITION:-${FE02_PARTITION:-}}"
export FE02_LITE_ACCOUNT="${FE02_LITE_ACCOUNT:-${FE02_ACCOUNT:-}}"
export FE02_LITE_QOS="${FE02_LITE_QOS:-${FE02_QOS:-}}"
export FE02_LITE_NODES="${FE02_LITE_NODES:-${FE02_NODES:-4}}"
export FE02_LITE_DEVICES_PER_NODE="${FE02_LITE_DEVICES_PER_NODE:-${FE02_DEVICES_PER_NODE:-4}}"
export FE02_LITE_CPUS_PER_TASK="${FE02_LITE_CPUS_PER_TASK:-${FE02_CPUS_PER_TASK:-8}}"
export FE02_LITE_GRES_KIND="${FE02_LITE_GRES_KIND:-${FE02_GRES_KIND:-dcu}}"
export FE02_LITE_MEMORY="${FE02_LITE_MEMORY:-}"
export FE02_LITE_WALLTIME="${FE02_LITE_WALLTIME:-23:50:00}"
export FE02_LITE_CONCURRENCY="${FE02_LITE_CONCURRENCY:-1}"
