# PRIVATE copy only. First prepare can generate this automatically from --inherit-session.
# Paths are resolved from the completed A01 session, not guessed or copied weights.
source "${ON_EVAL_SOURCE_SESSION:?}/runtime.private.env"
export ON_EVAL_PROJECT_ROOT="${ON_EVAL_PROJECT_ROOT:?}"
export ON_EVAL_SOURCE_SESSION="${ON_EVAL_SOURCE_SESSION:?}"
export ON_EVAL_RELEASE_ROOT="${ON_EVAL_RELEASE_ROOT:?}"
export ON_EVAL_OUTPUT_ROOT="$ON_EVAL_PROJECT_ROOT/outputs/fe01_on_eval_v4"
export ON_EVAL_INHERITED_CODE_ROOT="$A01_CODE_ROOT"
export ON_EVAL_CONDA_ENV=zb
export ON_EVAL_GRES="${A01_SINGLE_GRES:?}"
export ON_EVAL_PARTITION="${A01_PARTITION:-}"
export ON_EVAL_BLOCK_EVENTS=32
export ON_EVAL_MAX_CONCURRENT=8
# Optional per-stage overrides at the explicit submit command:
# ON_EVAL_MEM=96G ON_EVAL_TIME=24:00:00 ON_EVAL_CPU_PARTITION=...
# ON_EVAL_CONDA_BASE=/existing/conda/base (if conda info is unavailable in noninteractive shells)
# ON_EVAL_ENV_HOOK=/trusted/working/compute_environment.sh (optional)
# ON_EVAL_CHECKPOINT_MAP=/private/run_dir_map.json (only exact explicit relocation by family)
