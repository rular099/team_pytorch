{
  "extends": "${V01_ARM_CONFIG}",
  "training_params": {
    "validation_generator_overrides": {
      "causal_random_input_mask": {
        "enabled": true,
        "apply_probability": 1.0,
        "station_counts": [1, 3, 5, 8, 12, 16],
        "order_selected_by_pick": true,
        "target_sampling": {
          "enabled": true,
          "input_ratio": 0.0,
          "triggered_noninput_ratio": 0.2,
          "untriggered_ratio": 0.5,
          "fill_missing": true,
          "exclude_inputs": true
        }
      }
    }
  },
  "v01_validation_protocol": "random"
}
