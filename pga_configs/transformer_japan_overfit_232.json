{
    "seed": 42,
    "model": "transformer",
    "ensemble": 1,
    "model_params": {
        "waveform_model_dims": [
            1000,
            1000,
            1000
        ],
        "output_mlp_dims": [
            64
        ],
        "output_location_dims": [
            150,
            50
        ],
        "wavelength": [
            [0.01, 15],
            [0.01, 15],
            [0.01, 10]
        ],
        "mad_params": {
