{
    "extends": "transformer_japan_full_2000_2024_rt55_knet_legacy_paddingmask_no_dpk_chaosuan.json",
    "training_params": {
        "lr": 0.0001,
        "lr_adapter": 0.0001,
        "lr_team": 0.0001,
        "epochs_full_model": 6,
        "weight_path": "${RT56_WEIGHT_PATH}",
        "load_model_path": "${RT55_EP32_CHECKPOINT}",
        "transfer_model_path": null,
        "reinit_fpn": false,
        "lr_monitor": "val",
        "lr_decay_patience": 2,
        "lr_decay_factor": 0.5,
        "min_lr": 0.000001,
        "train_generator_overrides": {
            "causal_random_input_mask": {
                "enabled": true,
                "apply_probability": 0.5,
                "station_counts": [
                    1,
                    3,
                    5,
                    8,
                    12,
                    16
                ],
                "order_selected_by_pick": true,
                "target_sampling": {
                    "enabled": true,
                    "input_ratio": 0.0,
                    "triggered_noninput_ratio": 0.2,
                    "untriggered_ratio": 0.5,
                    "fill_missing": true,
                    "exclude_inputs": true
                }
            }
        },
        "validation_generator_overrides": {
            "causal_random_input_mask": {
                "enabled": true,
                "apply_probability": 1.0,
                "station_counts": [
                    1,
                    3,
                    5,
                    8,
                    12,
                    16
                ],
                "order_selected_by_pick": true,
                "target_sampling": {
                    "enabled": true,
                    "input_ratio": 0.0,
                    "triggered_noninput_ratio": 0.2,
                    "untriggered_ratio": 0.5,
                    "fill_missing": true,
                    "exclude_inputs": true
                }
            }
        }
    },
    "experiment_note": "rt56 starts from the pinned rt55 epoch-32 model weights with a fresh optimizer and scheduler. Each train sample keeps the original rt55 input/target protocol with probability 0.5, or draws a maximum input count from 1/3/5/8/12/16 and samples up to that many stations uniformly from all causally available triggered stations at the realtime cutoff with probability 0.5. Random geometry reserves at least one finite-PGA non-input station, and targets exclude selected inputs while retaining the triggered-noninput/untriggered balance. Validation always uses deterministic causal random geometry. Model architecture and the rt55 checkpoint-loading path are unchanged."
}
